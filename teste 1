    }
    .navbar ul{
        flex-direction: column;
        align-items: flex-start;
        gap: 2.4rem;
    }
    #hero{
        padding: 11rem 2rem 5rem;
    }
    #hero h1{
        font-size: 3.6rem;
    }
    .about-grid{
        grid-template-columns: 1fr;
    }
    .about-stats{
        flex-direction: row;
        border-left: none;
        border-top: 2px solid var(--silver-mid);
        padding-left: 0;
        padding-top: 2.4rem;
        gap: 3rem;
